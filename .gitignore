# --- Données (trop lourdes pour Git) ---
data/*.csv
data/*.zip
data/*.json

# --- Environnement Python ---
venv/
.env
__pycache__/
*.py[cod]
*.pyo
.Python

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Modèles sauvegardés ---
*.pkl
*.joblib
*.h5

# --- Système ---
.DS_Store
Thumbs.db
*.log

# --- IDE ---
.vscode/
.idea/
*.swp
